# Cloudflare Worker Local Development Variables (Example)
# Copy this file to .dev.vars for local development:
# cp .dev.vars.example .dev.vars

# Azure Translator API Key (from Azure Portal -> Translator resource -> Keys and Endpoint)
AZURE_TRANSLATOR_KEY="YOUR_AZURE_TRANSLATOR_KEY_HERE"

# Azure Translator Region (e.g. westeurope, eastus, centralus, or global)
AZURE_TRANSLATOR_REGION="westeurope"

# Optional Custom Endpoint (defaults to https://api.cognitive.microsofttranslator.com)
# AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"
