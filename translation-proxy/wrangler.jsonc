{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ambisun-translation-proxy",
  "main": "src/index.js",
  "compatibility_date": "2024-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "TRANSLATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
